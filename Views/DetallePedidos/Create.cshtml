@model SaborPrestigioMVC.Models.DetallePedido

@{
    ViewData["Title"] = "Agregar Platillo al Pedido";
}

<h1>Agregar Platillo al Pedido</h1>

<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="IdPedido" class="control-label">Pedido</label>
                <select asp-for="IdPedido"
                        asp-items="ViewBag.Pedidos"
                        class="form-control">
                    <option value="">Seleccione Pedido</option>
                </select>
            </div>

            <div class="form-group mb-3">
                <label asp-for="IdPlatillo" class="control-label">Platillo</label>
                <select asp-for="IdPlatillo"
                        asp-items="ViewBag.Platillos"
                        class="form-control">
                    <option value="">Seleccione Platillo</option>
                </select>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Cantidad" class="control-label"></label>
                <input asp-for="Cantidad" class="form-control" />
            </div>

            <div class="form-group mb-3">
                <label asp-for="PrecioUnitario" class="control-label"></label>
                <input asp-for="PrecioUnitario" class="form-control" />
            </div>

            <div class="form-group mb-3">
                <label asp-for="NotasChef" class="control-label"></label>
                <textarea asp-for="NotasChef" class="form-control"></textarea>
            </div>

            <input type="hidden" asp-for="Subtotal" />

            <div class="form-group">
                <input type="submit"
                       value="Agregar Platillo"
                       class="btn btn-primary" />
            </div>

        </form>
    </div>  
</div>

<div class="mt-3">
    <a asp-action="Index">Volver</a>
</div>