@model IEnumerable<SaborPrestigioMVC.Models.DetallePedido>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.IdPedido)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IdPlatillo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Cantidad)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PrecioUnitario)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Subtotal)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NotasChef)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Pedido)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Platillo)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.IdPedido)
            </td>
            <td>
                @Html.DisplayFor(model => item.IdPlatillo)
            </td>
            <td>
                @Html.DisplayFor(model => item.Cantidad)
            </td>
            <td>
                @Html.DisplayFor(model => item.PrecioUnitario)
            </td>
            <td>
                @Html.DisplayFor(model => item.Subtotal)
            </td>
            <td>
                @Html.DisplayFor(model => item.NotasChef)
            </td>
            <td>
                @Html.DisplayFor(model => item.Pedido)
            </td>
            <td>
                @Html.DisplayFor(model => item.Platillo)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.IdDetalle">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.IdDetalle">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.IdDetalle">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
