@model SaborPrestigioMVC.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<link rel="stylesheet" href="~/css/dashboard.css" />

<div class="dashboard-layout">

    <aside class="sidebar">
        <div class="logo">

            <img src="~/images/logo.png"
                 alt="Logo"
                 class="logo-img" />

            <div>Sabor y Prestigio</div>

            <small>RESTAURANTE</small>

        </div>

        <a class="active" asp-controller="Home" asp-action="Index">🏠 Dashboard</a>
        <a asp-controller="Clientes" asp-action="Index">👥 Clientes</a>
        <a asp-controller="Mesas" asp-action="Index">🍽 Mesas</a>
        <a asp-controller="Reservas" asp-action="Index">📅 Reservas</a>
        <a asp-controller="Pedidos" asp-action="Index">🛒 Pedidos</a>
        <a asp-controller="Platillos" asp-action="Index">🍴 Platillos</a>
        <a asp-controller="Insumos" asp-action="Index">📦 Inventario</a>
        <a asp-controller="ComprobantedePago" asp-action="Index">🧾 Comprobantes</a>
        <a asp-controller="RecetaPlatillos" asp-action="Index">📊 Reportes</a>
    </aside>

    <main class="main-dashboard">
        <div class="hero-dashboard">

            <div>
                <h1>Sabor y Prestigio</h1>

                <p>
                    Administración Integral del Restaurante
                </p>

                <span class="hero-date">
                    📅 @DateTime.Now.ToString("dd/MM/yyyy")
                </span>
            </div>

        </div>
   

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2>Dashboard Administrador / Gerente</h2>
                <span>Bienvenido, <strong class="text-danger">Administrador</strong></span>
            </div>

            <div>
                <span class="badge bg-light text-dark p-2">
                    📅 @DateTime.Now.ToString("dd/MM/yyyy")
                </span>
            </div>
        </div>

        <div class="kpi-card">
            <div class="kpi-icon">💰</div>
            <h6>Ventas Totales</h6>
            <h2>S/ 0.00</h2>
        </div>

            <div class="kpi-card">
                <h6>Pedidos del Día</h6>
                <h2>@Model.TotalPedidos</h2>
            </div>

            <div class="kpi-card">
                <h6>Clientes Registrados</h6>
                <h2>@Model.TotalClientes</h2>
            </div>

            <div class="kpi-card">
                <h6>Stock Crítico</h6>
                <h2>@Model.StockCritico</h2>
                <small class="text-danger">Ver detalles</small>
            </div>

            <div class="kpi-card">
                <h6>Mesas Disponibles</h6>
                <h2>@Model.MesasDisponibles</h2>
            </div>

            <div class="kpi-card">
                <h6>Comprobantes</h6>
                <h2>@Model.ComprobantesEmitidos</h2>
            </div>
        </div>

        <div class="dashboard-grid">
            <div class="dashboard-card equal-height">
                <h5>Ventas por Día</h5>

                @foreach (var venta in Model.VentasPorDia)
                {
                    var ancho = Model.VentasTotales > 0 ? (venta.Total / Model.VentasTotales) * 100 : 0;

                    <div class="mb-3">
                        <div class="d-flex justify-content-between">
                            <span>@venta.Dia</span>
                            <strong>S/ @venta.Total.ToString("0.00")</strong>
                        </div>

                        <div class="progress">
                            <div class="progress-bar bg-danger"
                                 role="progressbar"
                                 style="width:@ancho%">
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="dashboard-card equal-height">
                <h5>Pedidos por Estado</h5>

                <div class="mt-3">
                    <p>🔵 En Espera</p>
                    <p>🟠 En Preparación</p>
                    <p>🟢 Listo</p>
                    <p>🔴 Entregado</p>
                </div>

                <h2 class="text-center">@Model.TotalPedidos</h2>
                <p class="text-center">Total de pedidos</p>
            </div>
        </div>

        <div class="dashboard-card mb-4">
            <h5>Últimos Pedidos</h5>

            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Pedido</th>
                        <th>Cliente</th>
                        <th>Estado</th>
                        <th>Total</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var pedido in Model.UltimosPedidos)
                    {
                        <tr>
                            <td>#@pedido.IdPedido</td>

                            <td>
                                @(pedido.Cliente != null
                                    ? pedido.Cliente.Nombre + " " + pedido.Cliente.Apellido
                                    : "Sin Cliente")
                            </td>

                            <td>
                                <span class="badge bg-primary">@pedido.EstadoPedido</span>
                            </td>

                            <td>S/ @pedido.Total.ToString("0.00")</td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="row g-3 mt-3">
                <div class="col-md-3">
                    <a asp-controller="Pedidos"
                       asp-action="Create"
                       class="btn btn-danger w-100 quick-btn">
                        🛒 Nuevo Pedido
                    </a>
                </div>

                <div class="col-md-3">
                    <a asp-controller="Reservas"
                       asp-action="Create"
                       class="btn btn-warning w-100 quick-btn">
                        📅 Nueva Reserva
                    </a>
                </div>

                <div class="col-md-3">
                    <a asp-controller="Platillos"
                       asp-action="Create"
                       class="btn btn-dark w-100 quick-btn">
                        🍽 Nuevo Platillo
                    </a>
                </div>

                <div class="col-md-3">
                    <a asp-controller="ComprobantedePago"
                       asp-action="Create"
                       class="btn btn-danger w-100 quick-btn">
                        🧾 Emitir Comprobante
                    </a>
                </div>
            </div>
        </div>

    </main>
</div>