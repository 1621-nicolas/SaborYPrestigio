@model SaborPrestigioMVC.Models.Platillo

@{
    ViewData["Title"] = "Registrar Platillo";
}

<h1>Registrar Platillo</h1>
<hr />

<div class="row">
    <div class="col-md-5">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="NombrePlatillo">Nombre del Platillo</label>
                <input asp-for="NombrePlatillo" class="form-control" />
            </div>

            <div class="form-group mb-3">
                <label asp-for="DescripcionGourmet">Descripción</label>
                <textarea asp-for="DescripcionGourmet" class="form-control"></textarea>
            </div>

            <div class="form-group mb-3">
                <label asp-for="PrecioVenta">Precio de Venta</label>
                <input asp-for="PrecioVenta" class="form-control" />
            </div>

            <div class="form-group mb-3">
                <label asp-for="IdCategoria">Categoría</label>
                <select asp-for="IdCategoria" asp-items="ViewBag.Categorias" class="form-control">
                    <option value="">Seleccione Categoría</option>
                </select>
            </div>

            <div class="form-group mb-3">
                <label asp-for="TiempoEstimadoMin">Tiempo Estimado</label>
                <input asp-for="TiempoEstimadoMin" class="form-control" />
            </div>

            <div class="form-check mb-3">
                <input asp-for="Disponibilidad" class="form-check-input" />
                <label asp-for="Disponibilidad" class="form-check-label">Disponible</label>
            </div>

            <button type="submit" class="btn btn-primary">Guardar</button>
            <a asp-action="Index" class="btn btn-secondary">Volver</a>
        </form>
    </div>
</div>