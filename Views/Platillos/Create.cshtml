@model SaborPrestigioMVC.Models.Platillo

@{
    ViewData["Title"] = "Registrar Platillo";
}

<div class="container mt-4 text-warning">
    <h2>Registrar Platillo</h2>
    <h4 class="text-white small">Mantenimiento de Carta y Menú Gourmet</h4>
    <hr class="border-secondary" />

    <div class="row">
        <!-- Tarjeta contenedora con la estética del restaurante -->
        <div class="col-xl-6 col-md-8 mb-4">
            <div class="card bg-black border-secondary shadow-sm">
                <div class="card-header border-secondary bg-black text-warning fw-bold
                    <i class="fas fa-hamburger me-1"></i> Especificaciones del Platillo
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <!-- Nombre -->
                        <div class="form-group mb-3">
                            <label asp-for="NombrePlatillo" class="form-label fw-bold text-white">Nombre del Platillo</label>
                            <input asp-for="NombrePlatillo" class="form-control bg-black text-white border-secondary" placeholder="Ej. Lomo Saltado Gourmet" />
                            <span asp-validation-for="NombrePlatillo" class="text-danger small"></span>
                        </div>

                        <!-- Descripción -->
                        <div class="form-group mb-3">
                            <label asp-for="DescripcionGourmet" class="form-label fw-bold text-white">Descripción Corta o Notas</label>
                            <textarea asp-for="DescripcionGourmet" class="form-control bg-black text-white border-secondary" rows="3" placeholder="Flambeado al pisco con finas hiervas..."></textarea>
                            <span asp-validation-for="DescripcionGourmet" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <!-- Precio de Venta -->
                            <div class="col-md-6 form-group mb-3">
                                <label asp-for="PrecioVenta" class="form-label fw-bold text-white">Precio de Venta</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-secondary border-secondary text-black">S/</span>
                                    <input asp-for="PrecioVenta" type="number" step="0.01" class="form-control bg-black text-white border-secondary" placeholder="0.00" />
                                </div>
                                <span asp-validation-for="PrecioVenta" class="text-danger small"></span>
                            </div>

                            <!-- Tiempo Estimado -->
                            <div class="col-md-6 form-group mb-3">
                                <label asp-for="TiempoEstimadoMin" class="form-label fw-bold text-white">Tiempo de Cocina (Min.)</label>
                                <input asp-for="TiempoEstimadoMin" type="number" class="form-control bg-black text-white border-secondary" placeholder="Ej. 15" min="1" />
                                <span asp-validation-for="TiempoEstimadoMin" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Categoría (Desplegable Dinámico) -->
                        <div class="form-group mb-3">
                            <label asp-for="IdCategoria" class="form-label fw-bold text-white">Categoría de la Carta</label>
                            <select asp-for="IdCategoria" asp-items="ViewBag.Categorias" class="form-select bg-black text-white border-secondary">
                                <option value="">-- Seleccione Categoría --</option>
                            </select>
                            <span asp-validation-for="IdCategoria" class="text-danger small"></span>
                        </div>

                        <!-- Disponibilidad en formato Switch -->
                        <div class="form-check form-switch mb-4 mt-4">
                            <input asp-for="Disponibilidad" class="form-check-input" type="checkbox" id="switchDisponibilidad" checked />
                            <label class="form-check-label fw-bold text-warning" for="switchDisponibilidad">Habilitado para la venta</label>
                        </div>

                        <!-- Botones integrados -->
                        <div class="form-group pt-2 border-top border-secondary">
                            <button type="submit" class="btn btn-primary px-4 shadow">Guardar Registro</button>
                            <a asp-action="Index" class="btn btn-secondary px-4 ms-2">Volver</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}