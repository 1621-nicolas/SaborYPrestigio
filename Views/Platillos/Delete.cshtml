@model SaborPrestigioMVC.Models.Platillo

@{
    ViewData["Title"] = "Retirar Platillo";
}

<div class="container mt-5 text-white" style="max-width: 550px;">
    <div class="card border-danger bg-dark shadow">
        <div class="card-header bg-black border-danger py-3 text-center">
            <h4 class="text-danger mb-0"><i class="fas fa-trash-alt"></i> ¿Retirar platillo de la carta?</h4>
        </div>
        <div class="card-body p-4 text-center">
            <p class="text-muted">Esta acción eliminará de forma permanente el platillo de la base de datos de la carta.</p>

            <div class="p-3 bg-black rounded border border-secondary text-start my-4">
                <div class="mb-2"><strong>Platillo:</strong> <span class="text-white ms-2">@Model.NombrePlatillo</span></div>
                <div class="mb-2"><strong>Clasificación:</strong> <span class="text-muted ms-2">@(Model.CategoriaPlato?.NombreCategoria ?? "-")</span></div>
                <div><strong>Precio Actual:</strong> <span class="text-warning ms-2 fw-bold">S/ @Model.PrecioVenta.ToString("0.00")</span></div>
            </div>

            <form asp-action="Delete" asp-route-id="@Model.IdPlatillo" method="post" class="mt-4">
                <input type="hidden" asp-for="IdPlatillo" />
                <button type="submit" class="btn btn-danger px-4 fw-bold shadow">Confirmar Eliminación</button>
                <a asp-action="Index" class="btn btn-secondary px-4 ms-2">Cancelar</a>
            </form>
        </div>
    </div>
</div>