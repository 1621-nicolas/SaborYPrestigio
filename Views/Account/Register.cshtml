@model SaborPrestigioMVC.Models.Cliente

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Registro - Sabor y Prestigio</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
            body {
                background-color: #0a0a0a;
                font-family: sans-serif;
                display: flex;
                justify-content: center;
                align-items: center;
                min-height: 100vh;
                margin: 0;
                padding: 20px 0;
            }

            .login-card {
                background-color: #141414;
                border: 1px solid #ffc107;
                max-width: 500px;
                width: 100%;
                border-radius: 8px;
                padding: 2.5rem;
                box-shadow: 0 10px 30px rgba(0,0,0,0.8);
            }

            .form-control:focus {
                background-color: #000;
                color: #fff;
                border-color: #ffc107;
                box-shadow: 0 0 0 0.25rem rgba(255, 193, 7, 0.25);
            }
    </style>
</head>
<body>
    <div class="login-card text-white">

        <div class="text-center mb-4">
            <h3 class="text-warning fw-bold mb-1">ÚNETE A NUESTRA FAMILIA</h3>
            <p class="text-muted small">Crea tu cuenta para hacer pedidos y reservas</p>
        </div>

        <form asp-action="Register" method="post">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label small text-warning fw-bold">Nombre</label>
                    <input asp-for="Nombre" class="form-control bg-black text-white border-secondary" required />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label small text-warning fw-bold">Apellido</label>
                    <input asp-for="Apellido" class="form-control bg-black text-white border-secondary" required />
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label small text-warning fw-bold">DNI o RUC</label>
                    <input asp-for="DniRuc" class="form-control bg-black text-white border-secondary" required maxlength="11" />
                    <span asp-validation-for="DniRuc" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label small text-warning fw-bold">Teléfono</label>
                    <input asp-for="Telefono" class="form-control bg-black text-white border-secondary" required maxlength="9" />
                    <span asp-validation-for="Telefono" class="text-danger small"></span>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label small text-warning fw-bold">Correo Electrónico</label>
                <input asp-for="Email" type="email" class="form-control bg-black text-white border-secondary" required />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label class="form-label small text-warning fw-bold">Crea una Contraseña</label>
                <input asp-for="Clave" type="password" class="form-control bg-black text-white border-secondary" required />
            </div>

            <button type="submit" class="btn btn-warning w-100 fw-bold shadow-sm py-2">
                Crear Mi Cuenta
            </button>

            <div class="mt-3 text-center">
                <span class="text-muted small">¿Ya tienes cuenta?</span>
                <a asp-action="Login" class="text-warning text-decoration-none fw-bold small ms-1">
                    Inicia sesión
                </a>
            </div>
        </form>

    </div>
</body>
</html>