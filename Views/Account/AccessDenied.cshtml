@{
    ViewData["Title"] = "Acceso Denegado";
}
<div class="container text-white mt-5 text-center">
    <h2>🚫 Acceso Denegado</h2>
    <p>No tienes los permisos necesarios para ver esta página.</p>

    <div class="mt-4">
        @if (User.IsInRole("Cliente"))
        {
            <a asp-controller="ClientePortal" asp-action="Index" class="btn btn-warning">Volver a mi Portal</a>
        }
        else
        {
            <a asp-controller="Home" asp-action="Index" class="btn btn-warning">Volver al Inicio</a>
        }
    </div>
</div>