@model IEnumerable<SaborPrestigioMVC.Models.Empleado>

@{
    ViewData["Title"] = "Empleados";
}

<link rel="stylesheet" href="~/css/dashboard.css" />

<div class="dashboard-card">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <h4 class="titulo-estados"> Gestión de Empleados</h4>

        <a asp-action="Create" class="btn btn-warning fw-bold">
            + Nuevo Empleado
        </a>

    </div>

    <div class="table-responsive">

        <table class="table table-hover table-dark table-striped align-middle">

            <thead>
                <tr>
                    <th>DNI</th>
                    <th>Nombre</th>
                    <th>Apellido</th>
                    <th>Teléfono</th>
                    <th>Correo</th>
                    <th>Usuario</th>
                    <th>Rol</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>

                        <td>@item.Dni</td>

                        <td>@item.Nombre</td>

                        <td>@item.Apellido</td>

                        <td>@item.Telefono</td>

                        <td>@item.Correo</td>

                        <td>@item.Usuario</td>

                        <td>
                            @if (item.Rol != null)
                            {
                                @item.Rol.NombreRol
                            }
                            else
                            {
                                <span class="text-muted">Sin rol</span>
                            }
                        </td>

                        <td>
                            @if (item.Estado == "Activo")
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else if (item.Estado == "Inactivo")
                            {
                                <span class="badge bg-danger">Inactivo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@item.Estado</span>
                            }
                        </td>

                        <td>
                            <a asp-action="Edit" asp-route-id="@item.IdEmpleado" class="btn btn-sm btn-primary">Editar</a>
                            <a asp-action="Details" asp-route-id="@item.IdEmpleado" class="btn btn-sm btn-info text-white">Ver</a>
                            <a asp-action="Delete" asp-route-id="@item.IdEmpleado" class="btn btn-sm btn-danger">Eliminar</a>
                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>