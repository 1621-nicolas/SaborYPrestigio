@model IEnumerable<SaborPrestigioMVC.Models.RecetaPlatillo>

@{
    ViewData["Title"] = "Recetas de Platillos";
}

<h1>Recetas de Platillos</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Registrar Receta</a>
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Platillo</th>
            <th>Insumo</th>
            <th>Cantidad Requerida</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Platillo?.NombrePlatillo</td>
                <td>@item.Insumo?.NombreInsumo</td>
                <td>@item.CantidadRequerida</td>
            </tr>
        }
    </tbody>
</table>