@model IEnumerable<SaborPrestigioMVC.Models.RecetaPlatillo>

@{
    ViewData["Title"] = "Recetas de Platillos";
}
<link rel="stylesheet" href="~/css/dashboard.css" />

<div class="dashboard-card">
    <div class="d-flex justify-content-between align-items-center mb-4 text-white">
        <div>
            <h2 class="mb-0"><i class="fas fa-book-open me-2"></i>Fórmulas y Recetas de Platillos</h2>
        </div>

        <div class="d-flex gap-2">
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-light d-flex align-items-center">
                <i class="fas fa-arrow-left me-2"></i> Volver al Inicio
            </a>
            <a asp-action="Create" class="btn btn-warning fw-bold text-dark d-flex align-items-center">
                <i class="fas fa-plus me-1"></i> Registrar Receta
            </a>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover table-dark table-striped align-middle border-secondary">
            <thead class="table-black text-muted small text-uppercase">
                <tr>
                    <th>Platillo Destino</th>
                    <th>Insumo Requerido</th>
                    <th class="text-center" style="width: 250px;">Cantidad de Consumo</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong class="text-warning">@item.Platillo?.NombrePlatillo</strong></td>
                        <td><span class="text-white">@item.Insumo?.NombreInsumo</span></td>
                        <td class="text-center">
                            <span class="badge bg-dark border border-secondary text-info px-4 py-2 font-mono fs-6">
                                @item.CantidadRequerida.ToString("0.000") @item.Insumo?.UnidadMedida
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>