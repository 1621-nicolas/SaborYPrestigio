@model SaborPrestigioMVC.Models.RecetaPlatillo

@{
    ViewData["Title"] = "Registrar Receta";
}

<div class="container-fluid px-4 text-white">
    <h2 class="mt-3">Composición de Recetas Gourmet</h2>
    <h4 class="text-muted small">Mantenimiento y Desglose Operacional de Cocina</h4>
    <hr class="border-secondary" />

    <form asp-action="Create" method="post" id="formReceta">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger bg-danger text-white border-0 d-none" id="alertError"></div>

        <div class="row">
            <!-- IZQUIERDA: SELECCIÓN DEL PLATILLO MAESTRO -->
            <div class="col-xl-4 col-md-5 mb-4">
                <div class="card bg-dark border-secondary h-100 shadow-sm">
                    <div class="card-header border-secondary bg-black text-warning fw-bold">
                        <i class="fas fa-wine-glass-alt me-1"></i> Platillo Destino
                    </div>
                    <div class="card-body">
                        <div class="form-group mb-3">
                            <label class="form-label fw-bold text-warning">Seleccione Platillo</label>
                            <select name="idPlatillo" id="idPlatillo" asp-items="ViewBag.Platillos" class="form-select bg-black text-warning border-secondary" required>
                                <option value="">-- Seleccione Platillo --</option>
                            </select>
                        </div>
                        <p class="text-muted small mt-4">
                            * Al asociar los insumos correctos, el sistema descontará automáticamente del stock de inventario cada vez que se venda este plato en el salón o vía web.
                        </p>
                    </div>
                </div>
            </div>

            <!-- DERECHA: AGREGAR INGREDIENTES DINÁMICOS -->
            <div class="col-xl-8 col-md-7 mb-4">
                <div class="card bg-dark border-secondary shadow-sm">
                    <div class="card-header border-secondary bg-black text-warning fw-bold">
                        <i class="fas fa-leaf me-1"></i> Desglose de Porciones e Insumos
                    </div>
                    <div class="card-body">
                        <div class="row g-2 align-items-end mb-4">
                            <div class="col-md-6">
                                <label class="form-label text-warning small fw-bold">Insumo / Materia Prima</label>
                                <select id="selectInsumo" class="form-select bg-black text-warning border-secondary">
                                    <option value="">-- Elija un Insumo --</option>
                                    @if (ViewBag.InsumosRaw != null)
                                    {
                                        foreach (var ins in ViewBag.InsumosRaw)
                                        {
                                            var id = ins.GetType().GetProperty("IdInsumo").GetValue(ins, null);
                                            var nombreUnidad = ins.GetType().GetProperty("NombreUnidad").GetValue(ins, null).ToString();
                                            <option value="@id">@nombreUnidad</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label text-warning small fw-bold">Cantidad Requerida</label>
                                <input type="number" id="txtCantidad" step="0.001" class="form-control bg-black text-warning border-secondary text-center" placeholder="0.000" min="0.001" />
                            </div>
                            <div class="col-md-2">
                                <button type="button" id="btnAgregarInsumo" class="btn btn-warning w-100 fw-bold">Añadir</button>
                            </div>
                        </div>

                        <!-- TABLA DINÁMICA -->
                        <div class="table-responsive">
                            <table class="table table-dark table-hover border-secondary align-middle" id="tablaIngredientes">
                                <thead class="table-black text-muted small text-uppercase">
                                    <tr>
                                        <th>Insumo</th>
                                        <th class="text-center" style="width: 200px;">Cantidad Requerida</th>
                                        <th class="text-center" style="width: 100px;">Acción</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <!-- Inyección vía JS -->
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-2 mb-5">
            <button type="submit" class="btn btn-primary px-4 shadow">Guardar Receta Completa</button>
            <a asp-action="Index" class="btn btn-secondary px-4 ms-2">Volver</a>
        </div>
    </form>
</div>

<style>
    select.form-select option {
        background-color: #000000 !important;
        color: #ffc107 !important;
    }
</style>

@section Scripts {
    <script>
        let indexIngrediente = 0;

        document.getElementById("btnAgregarInsumo").addEventListener("click", function() {
            const select = document.getElementById("selectInsumo");
            const idInsumo = select.value;
            const textInsumo = select.options[select.selectedIndex].text;
            const cantidad = parseFloat(document.getElementById("txtCantidad").value);

            if (!idInsumo || isNaN(cantidad) || cantidad <= 0) {
                alert("Por favor seleccione un insumo válido y especifique su cantidad.");
                return;
            }

            const tbody = document.querySelector("#tablaIngredientes tbody");
            const fila = document.createElement("tr");
            fila.setAttribute("id", `fila-${indexIngrediente}`);
            fila.innerHTML = `
                        <td>
                            <input type="hidden" name="ingredientes[${indexIngrediente}].IdInsumo" value="${idInsumo}" />
                            ${textInsumo}
                        </td>
                        <td class="text-center">
                            <input type="hidden" name="ingredientes[${indexIngrediente}].CantidadRequerida" value="${cantidad}" />
                            <span class="badge bg-secondary px-3 py-2 fs-6">${cantidad.toFixed(3)}</span>
                        </td>
                        <td class="text-center">
                            <button type="button" class="btn btn-outline-danger btn-sm" onclick="removerFila(${indexIngrediente})"><i class="fas fa-trash"></i></button>
                        </td>
                    `;

            tbody.appendChild(fila);
            indexIngrediente++;

            // Limpieza
            select.value = "";
            document.getElementById("txtCantidad").value = "";
        });

        function removerFila(index) {
            document.getElementById(`fila-${index}`).remove();
            reindexarIngredientes();
        }

        function reindexarIngredientes() {
            indexIngrediente = 0;
            document.querySelectorAll("#tablaIngredientes tbody tr").forEach(fila => {
                fila.setAttribute("id", `fila-${indexIngrediente}`);
                fila.querySelector('input[name$=".IdInsumo"]').setAttribute("name", `ingredientes[${indexIngrediente}].IdInsumo`);
                fila.querySelector('input[name$=".CantidadRequerida"]').setAttribute("name", `ingredientes[${indexIngrediente}].CantidadRequerida`);
                fila.querySelector('button').setAttribute("onclick", `removerFila(${indexIngrediente})`);
                indexIngrediente++;
            });
        }

        document.getElementById("formReceta").addEventListener("submit", function(e) {
            const totalRows = document.querySelectorAll("#tablaIngredientes tbody tr").length;
            if (totalRows === 0) {
                e.preventDefault();
                const errBox = document.getElementById("alertError");
                errBox.innerText = "Error: No puede guardar una receta vacía sin ingredientes.";
                errBox.classList.remove("d-none");
            }
        });
    </script>
}