@model SaborPrestigioMVC.Models.RecetaPlatillo

@{
    ViewData["Title"] = "Registrar Receta";
}

<h1>Registrar Receta</h1>

<hr />

<div class="row">
    <div class="col-md-5">
        <form asp-action="Create" method="post">

            <div class="form-group mb-3">
                <label asp-for="IdPlatillo">Platillo</label>
                <select asp-for="IdPlatillo" asp-items="ViewBag.Platillos" class="form-control">
                    <option value="">Seleccione Platillo</option>
                </select>
            </div>

            <div class="form-group mb-3">
                <label asp-for="IdInsumo">Insumo</label>
                <select asp-for="IdInsumo" asp-items="ViewBag.Insumos" class="form-control">
                    <option value="">Seleccione Insumo</option>
                </select>
            </div>

            <div class="form-group mb-3">
                <label asp-for="CantidadRequerida">Cantidad Requerida</label>
                <input asp-for="CantidadRequerida" class="form-control" />
            </div>

            <button type="submit" class="btn btn-primary">Guardar</button>
            <a asp-action="Index" class="btn btn-secondary">Volver</a>
        </form>
    </div>
</div>