@model SaborPrestigioMVC.Models.Mesa

@{
    ViewData["Title"] = "Desactivar Mesa";
}

<link rel="stylesheet" href="~/css/dashboard.css" />

<div class="main-dashboard">

    <div class="dashboard-card">

        <div class="text-center mb-4">

            <h2 class="text-danger">
                ⚠ Desactivar Mesa
            </h2>

            <p style="color:#ccc;">
                La mesa no será eliminada del sistema.
                Se marcará como <strong>Fuera de Servicio</strong>.
            </p>

        </div>

        <div class="row">

            <div class="col-md-6">

                <div class="mb-3">
                    <label class="form-label">Número de Mesa</label>
                    <input class="form-control"
                           value="@Model.NumeroMesa"
                           readonly />
                </div>

                <div class="mb-3">
                    <label class="form-label">Capacidad</label>
                    <input class="form-control"
                           value="@Model.Capacidad personas"
                           readonly />
                </div>

            </div>

            <div class="col-md-6">

                <div class="mb-3">
                    <label class="form-label">Zona</label>
                    <input class="form-control"
                           value="@Model.Zona"
                           readonly />
                </div>

                <div class="mb-3">
                    <label class="form-label">Estado Actual</label>
                    <input class="form-control"
                           value="@Model.Estado"
                           readonly />
                </div>

            </div>

        </div>

        <hr />

        <form asp-action="Delete">

            <input type="hidden" asp-for="IdMesa" />

            <div class="d-flex gap-2">

                <button type="submit"
                        class="btn btn-danger">
                    🚫 Marcar como Fuera de Servicio
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Cancelar
                </a>

            </div>

        </form>

    </div>

</div>