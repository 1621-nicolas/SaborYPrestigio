@model SaborPrestigioMVC.Models.Mesa

@{
    ViewData["Title"] = "Nueva Mesa";
}

<link rel="stylesheet" href="~/css/dashboard.css" />

<div class="main-dashboard">

    <div class="dashboard-card">

        <div class="d-flex justify-content-between align-items-center mb-4">

            <div>
                <h2 class="titulo-ventas">🍽 Nueva Mesa</h2>
                <span style="color:#ccc;">
                    Registrar una nueva mesa del restaurante
                </span>
            </div>

            <a asp-action="Index"
               class="btn btn-secondary">
                ← Volver
            </a>

        </div>

        <form asp-action="Create">

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger">
            </div>

            <div class="row">

                <div class="col-md-6 mb-3">

                    <label asp-for="NumeroMesa"
                           class="form-label">
                        Número de Mesa
                    </label>

                    <input asp-for="NumeroMesa"
                           class="form-control" />

                    <span asp-validation-for="NumeroMesa"
                          class="text-danger"></span>

                </div>

                <div class="col-md-6 mb-3">

                    <label asp-for="Capacidad"
                           class="form-label">
                        Capacidad
                    </label>

                    <input asp-for="Capacidad"
                           class="form-control"
                           type="number" />

                    <span asp-validation-for="Capacidad"
                          class="text-danger"></span>

                </div>

            </div>

            <div class="row">

                <div class="col-md-6 mb-3">

                    <label asp-for="Zona"
                           class="form-label">
                        Zona
                    </label>

                    <select asp-for="Zona"
                            class="form-select">

                        <option value="">Seleccione...</option>

                        <option value="Interior">
                            Interior
                        </option>

                        <option value="Terraza">
                            Terraza
                        </option>

                        <option value="VIP">
                            VIP
                        </option>

                    </select>

                    <span asp-validation-for="Zona"
                          class="text-danger"></span>

                </div>

                <div class="col-md-6 mb-3">

                    <label asp-for="Estado"
                           class="form-label">
                        Estado
                    </label>

                    <select asp-for="Estado"
                            class="form-select">

                        <option value="Disponible">
                            Disponible
                        </option>

                        <option value="Reservada">
                            Reservada
                        </option>

                        <option value="Ocupada">
                            Ocupada
                        </option>

                        <option value="Fuera de Servicio">
                            Fuera de Servicio
                        </option>

                    </select>

                    <span asp-validation-for="Estado"
                          class="text-danger"></span>

                </div>

            </div>

            <hr class="mb-4" />

            <div class="d-flex gap-2">

                <button type="submit"
                        class="btn btn-warning fw-bold">
                    💾 Guardar Mesa
                </button>

                <a asp-action="Index"
                   class="btn btn-outline-light">
                    Cancelar
                </a>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}