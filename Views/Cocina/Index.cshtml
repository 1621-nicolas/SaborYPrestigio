@model SaborPrestigioMVC.Models.CocinaDashboardViewModel

@{
    ViewData["Title"] = "Dashboard Cocina";
}

<link rel="stylesheet" href="~/css/dashboard.css" />

<div class="dashboard-layout">

    <aside class="sidebar">
        <div class="logo">
            👨‍🍳 Cocina
            <small>Sabor y Prestigio</small>
        </div>

        <a class="active">🍳 Cocina</a>
        <a asp-controller="Pedidos" asp-action="Index">🛒 Pedidos</a>
        <a asp-controller="Platillos" asp-action="Index">🍽 Platillos</a>
        <a asp-controller="Home" asp-action="Index">📊 Dashboard</a>
    </aside>

    <main class="main-dashboard">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2>Panel de Cocina</h2>
                <span>Bienvenido, <strong class="text-danger">Chef</strong></span>
            </div>

            <span class="badge bg-light text-dark p-2">
                📅 @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
            </span>
        </div>

        <div class="kpi-row">

            <div class="kpi-card">
                <h6>Pedidos en Espera</h6>
                <h1 class="text-warning">@Model.PedidosEnEspera</h1>
            </div>

            <div class="kpi-card">
                <h6>En Cocina</h6>
                <h1 class="text-primary">@Model.PedidosEnCocina</h1>
            </div>

            <div class="kpi-card">
                <h6>Listos</h6>
                <h1 class="text-success">@Model.PedidosListos</h1>
            </div>

        </div>

        <div class="dashboard-card mb-4">
            <h4>Cola de Producción</h4>

            <div class="pedido-grid">

                @foreach (var pedido in Model.PedidosCocina)
                {
                    <div class="pedido-chef-card">

                        <div class="pedido-header">
                            <h5>Pedido #@pedido.IdPedido</h5>

                            @if (pedido.EstadoPedido == "En Espera")
                            {
                                <span class="badge bg-warning">
                                    @pedido.EstadoPedido
                                </span>
                            }
                            else if (pedido.EstadoPedido == "En Preparación")
                            {
                                <span class="badge bg-primary">
                                    @pedido.EstadoPedido
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success">
                                    @pedido.EstadoPedido
                                </span>
                            }
                        </div>

                        <hr />

                        <p>
                            <strong>Cliente:</strong>
                            @(pedido.Cliente?.Nombre ?? "Sin Cliente")
                        </p>

                        <p>
                            <strong>Mesa:</strong>
                            @(pedido.Mesa?.NumeroMesa ?? 0)
                        </p>

                        <div class="platillos-lista">

                            @foreach (var detalle in pedido.DetallePedidos)
                            {
                                <div>
                                    🍽 @detalle.Cantidad x
                                    @detalle.Platillo.NombrePlatillo
                                </div>
                            }

                        </div>

                        <div class="mt-3">

                            @if (pedido.EstadoPedido == "En Espera")
                            {
                                <form asp-action="CambiarEstado" method="post">
                                    <input type="hidden"
                                           name="idPedido"
                                           value="@pedido.IdPedido" />

                                    <input type="hidden"
                                           name="nuevoEstado"
                                           value="En Preparación" />

                                    <button class="btn btn-primary w-100">
                                        Iniciar Preparación
                                    </button>
                                </form>
                            }

                            @if (pedido.EstadoPedido == "En Preparación")
                            {
                                <form asp-action="CambiarEstado" method="post">
                                    <input type="hidden"
                                           name="idPedido"
                                           value="@pedido.IdPedido" />

                                    <input type="hidden"
                                           name="nuevoEstado"
                                           value="Listo" />

                                    <button class="btn btn-success w-100">
                                        Marcar Listo
                                    </button>
                                </form>
                            }

                        </div>

                    </div>
                }

            </div>
        </div>

        <div class="dashboard-card">

            <h4>Platillos Más Pedidos</h4>

            <table class="table table-hover">

                <thead>
                    <tr>
                        <th>Platillo</th>
                        <th>Cantidad Vendida</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model.PlatillosMasPedidos)
                    {
                        <tr>
                            <td>@item.NombrePlatillo</td>
                            <td>@item.CantidadVendida</td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </main>

</div>  