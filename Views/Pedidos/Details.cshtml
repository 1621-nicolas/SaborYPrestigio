@model SaborPrestigioMVC.Models.Pedido

@{
    ViewData["Title"] = "Detalle del Pedido";
}

<div class="container mt-4 text-white" style="max-width: 800px;">
    <div class="card bg-dark border-secondary shadow">
        <div class="card-header bg-black border-secondary d-flex justify-content-between align-items-center py-3">
            <h4 class="text-warning mb-0"><i class="fas fa-receipt"></i> Comanda Digital N° #@Model.IdPedido</h4>
            <span class="badge bg-primary text-uppercase px-3 py-2">@Model.EstadoPedido</span>
        </div>
        <div class="card-body bg-black m-3 rounded border border-secondary p-4">
            <!-- Encabezado del ticket -->
            <div class="row mb-4">
                <div class="col-sm-6 mb-2">
                    <small class="text-muted d-block text-uppercase fw-bold">Cliente</small>
                    <span>@(Model.Cliente?.Nombre ?? "Cliente General")</span>
                </div>
                <div class="col-sm-6 mb-2">
                    <small class="text-muted d-block text-uppercase fw-bold">Atendido por</small>
                    <span>@(Model.Empleado?.Nombre ?? "Canal Virtual Web")</span>
                </div>
                <div class="col-sm-6 mb-2">
                    <small class="text-muted d-block text-uppercase fw-bold">Mesa / Ubicación</small>
                    <span>@(Model.Mesa != null ? $"Mesa {Model.Mesa.NumeroMesa}" : "Para llevar / Delivery")</span>
                </div>
                <div class="col-sm-6 mb-2">
                    <small class="text-muted d-block text-uppercase fw-bold">Fecha de Registro</small>
                    <span>@Model.FechaPedido.ToString("dd/MM/yyyy HH:mm")</span>
                </div>
            </div>

            <hr class="border-secondary" />

            <!-- Cuerpo del ticket -->
            <h5 class="text-warning mb-3">Platillos Solicitados</h5>
            <table class="table table-dark table-borderless align-middle">
                <thead>
                    <tr class="border-bottom border-secondary text-muted small">
                        <th>Descripción</th>
                        <th class="text-center">Cant.</th>
                        <th class="text-end">Precio</th>
                        <th class="text-end">Subtotal</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.DetallePedidos != null)
                    {
                        foreach (var item in Model.DetallePedidos)
                        {
                            var subtotal = item.Cantidad * item.PrecioUnitario;
                            <tr>
                                <td>
                                    <div class="fw-bold">@item.Platillo?.NombrePlatillo</div>
                                    @if (!string.IsNullOrEmpty(item.NotasChef))
                                    {
                                        <small class="text-warning">* Nota: @item.NotasChef</small>
                                    }
                                </td>
                                <td class="text-center"><span class="badge bg-secondary">@item.Cantidad</span></td>
                                <td class="text-end">S/ @item.PrecioUnitario.ToString("0.00")</td>
                                <td class="text-end text-info">S/ @subtotal.ToString("0.00")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>

            <div class="border-top border-secondary pt-3 mt-4 d-flex justify-content-between align-items-center">
                <span class="fs-4 fw-bold text-warning">TOTAL NETO:</span>
                <span class="fs-3 fw-bold text-warning">S/ @Model.Total.ToString("0.00")</span>
            </div>
        </div>
        <div class="card-footer bg-black border-secondary py-3 text-end">

            <a asp-action="Index" class="btn btn-secondary px-4 ms-2">Volver</a>
        </div>
    </div>
</div>