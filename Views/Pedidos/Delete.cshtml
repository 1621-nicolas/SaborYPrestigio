@model SaborPrestigioMVC.Models.Pedido

@{
    ViewData["Title"] = "Anular Pedido";
}

<div class="container mt-5 text-white" style="max-width: 600px;">
    <div class="card border-danger bg-dark shadow-lg">
        <div class="card-header bg-black border-danger py-3 text-center">
            <h4 class="text-danger mb-0"><i class="fas fa-exclamation-triangle"></i> ¿Desea anular esta comanda?</h4>
        </div>
        <div class="card-body text-center p-4">
            <p class="text-muted">Esta acción eliminará el pedido <strong>N° #@Model.IdPedido</strong> y todos sus platillos asociados del sistema del restaurante.</p>

            <div class="p-3 bg-black rounded border border-secondary my-3 text-start">
                <div class="row">
                    <div class="col-6 mb-2"><strong>Tipo de Pedido:</strong></div>
                    <div class="col-6 mb-2 text-end">@Model.TipoPedido</div>
                    <div class="col-6 mb-2"><strong>Fecha original:</strong></div>
                    <div class="col-6 mb-2 text-end">@Model.FechaPedido.ToString("dd/MM/yyyy")</div>
                    <div class="col-6"><strong>Monto a revertir:</strong></div>
                    <div class="col-6 text-end text-warning fw-bold">S/ @Model.Total.ToString("0.00")</div>
                </div>
            </div>

            <form asp-action="Delete" asp-route-idpedido="@Model.IdPedido" method="post" class="mt-4">
                <input type="hidden" asp-for="IdPedido" />
                <button type="submit" class="btn btn-danger px-4 fw-bold shadow">Confirmar Anulación</button>
                <a asp-action="Index" class="btn btn-secondary px-4 ms-2">Cancelar</a>
            </form>
        </div>
    </div>
</div>