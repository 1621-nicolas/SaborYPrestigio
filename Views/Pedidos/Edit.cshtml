@model SaborPrestigioMVC.Models.Pedido

@{
    ViewData["Title"] = "Editar Pedido";
}

<div class="container-fluid px-4 text-white">
    <h2 class="mt-3">Modificar Pedido N° #@Model.IdPedido</h2>
    <hr class="border-secondary" />

    <form asp-action="Edit" method="post" id="formPedido">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger bg-danger text-white border-0 d-none" id="alertError"></div>
        <input type="hidden" asp-for="IdPedido" />

        <div class="row">
            <!-- GENERAL -->
            <div class="col-xl-4 col-md-5 mb-4">
                <div class="card bg-dark border-secondary shadow-sm">
                    <div class="card-header border-secondary bg-black text-warning fw-bold">
                        <i class="fas fa-edit me-1"></i> Cabecera de Comanda
                    </div>
                    <div class="card-body">
                        <div class="form-group mb-3">
                            <label asp-for="IdCliente" class="form-label text-muted fw-bold">Cliente</label>
                            <select asp-for="IdCliente" asp-items="ViewBag.Clientes" class="form-select bg-black text-white border-secondary">
                                <option value="">-- Seleccione Cliente --</option>
                            </select>
                        </div>
                        <div class="form-group mb-3">
                            <label asp-for="IdEmpleado" class="form-label text-muted fw-bold">Empleado (Mozo)</label>
                            <select asp-for="IdEmpleado" asp-items="ViewBag.Empleados" class="form-select bg-black text-white border-secondary"></select>
                        </div>
                        <div class="form-group mb-3">
                            <label asp-for="IdMesa" class="form-label text-muted fw-bold">Mesa</label>
                            <select asp-for="IdMesa" asp-items="ViewBag.Mesas" class="form-select bg-black text-white border-secondary"></select>
                        </div>
                        <div class="form-group mb-3">
                            <label asp-for="TipoPedido" class="form-label text-muted fw-bold">Tipo</label>
                            <select asp-for="TipoPedido" class="form-select bg-black text-white border-secondary">
                                <option value="Mesa">Mesa</option>
                                <option value="Web - Recojo en local">Web - Recojo en local</option>
                                <option value="Web - Preorden">Web - Preorden</option>
                            </select>
                        </div>
                        <div class="form-group mb-3">
                            <label asp-for="EstadoPedido" class="form-label text-muted fw-bold">Estado</label>
                            <select asp-for="EstadoPedido" class="form-select bg-black text-white border-secondary">
                                <option value="En Espera">En Espera</option>
                                <option value="En Cocina">En Cocina</option>
                                <option value="Listo">Listo</option>
                                <option value="Entregado">Entregado</option>
                                <option value="Cancelado">Cancelado</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <!-- DETALLES -->
            <div class="col-xl-8 col-md-7 mb-4">
                <div class="card bg-dark border-secondary shadow-sm">
                    <div class="card-header border-secondary bg-black text-warning fw-bold">
                        <i class="fas fa-pizza-slice me-1"></i> Modificar Platillos Añadidos
                    </div>
                    <div class="card-body">
                        <div class="row g-2 align-items-end mb-4">
                            <div class="col-md-5">
                                <label class="form-label text-muted small fw-bold">Platillo</label>
                                <select id="selectPlatillo" class="form-select bg-black text-white border-secondary">
                                    <option value="">-- Elija un Platillo --</option>
                                    @if (ViewBag.Platillos != null)
                                    {
                                        foreach (var p in ViewBag.Platillos)
                                        {
                                            var id = p.GetType().GetProperty("IdPlatillo").GetValue(p, null);
                                            var nombrePrecio = p.GetType().GetProperty("NombrePrecio").GetValue(p, null).ToString();
                                            var precio = nombrePrecio.Split("S/ ")[1].Replace(")", "");
                                            <option value="@id" data-precio="@precio">@nombrePrecio</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label text-muted small fw-bold">Cantidad</label>
                                <input type="number" id="txtCantidad" class="form-control bg-black text-white border-secondary text-center" value="1" min="1" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label text-muted small fw-bold">Notas</label>
                                <input type="text" id="txtNotas" class="form-control bg-black text-white border-secondary" placeholder="Notas adicionales..." />
                            </div>
                            <div class="col-md-2">
                                <button type="button" id="btnAgregarPlatillo" class="btn btn-warning w-100 fw-bold">Añadir</button>
                            </div>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-dark table-hover border-secondary align-middle" id="tablaDetalles">
                                <thead class="table-black text-muted small text-uppercase">
                                    <tr>
                                        <th>Platillo</th>
                                        <th class="text-center">Cantidad</th>
                                        <th class="text-end">Precio</th>
                                        <th class="text-end">Subtotal</th>
                                        <th>Notas</th>
                                        <th class="text-center">Acción</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        int i = 0;
                                    }
                                    @if (Model.DetallePedidos != null)
                                    {
                                        foreach (var item in Model.DetallePedidos)
                                        {
                                            var st = item.Cantidad * item.PrecioUnitario;
                                            <tr id="fila-@i">
                                                <td>
                                                    <input type="hidden" name="DetallePedidos[@i].IdPlatillo" value="@item.IdPlatillo" />
                                                    @item.Platillo?.NombrePlatillo
                                                </td>
                                                <td class="text-center">
                                                    <input type="hidden" name="DetallePedidos[@i].Cantidad" value="@item.Cantidad" />
                                                    <span class="badge bg-secondary px-3 py-2">@item.Cantidad</span>
                                                </td>
                                                <td class="text-end">S/ @item.PrecioUnitario.ToString("0.00")</td>
                                                <td class="text-end text-info fw-bold subtotal-item" data-subtotal="@st">S/ @st.ToString("0.00")</td>
                                                <td>
                                                    <input type="hidden" name="DetallePedidos[@i].NotasChef" value="@item.NotasChef" />
                                                    <span class="text-muted small">@(item.NotasChef ?? "-")</span>
                                                </td>
                                                <td class="text-center">
                                                    <button type="button" class="btn btn-outline-danger btn-sm" onclick="quitarFila(@i)"><i class="fas fa-trash"></i></button>
                                                </td>
                                            </tr>
                                            i++;
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="d-flex justify-content-end align-items-center mt-3 p-3 bg-black rounded border border-secondary">
                            <span class="fs-5 text-muted me-3">Total Consolidado:</span>
                            <span class="fs-3 text-warning fw-bold" id="lblTotal">S/ @Model.Total.ToString("0.00")</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-2 mb-5">
            <button type="submit" class="btn btn-primary px-4 shadow">Actualizar Pedido</button>
            <a asp-action="Index" class="btn btn-secondary px-4 ms-2">Volver</a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        let itemIndex = document.querySelectorAll("#tablaDetalles tbody tr").length;

        document.getElementById("btnAgregarPlatillo").addEventListener("click", function() {
            const select = document.getElementById("selectPlatillo");
            const idPlatillo = select.value;
            const textPlatillo = select.options[select.selectedIndex].text;
            const precioUnitario = parseFloat(select.options[select.selectedIndex].getAttribute("data-precio"));
            const cantidad = parseInt(document.getElementById("txtCantidad").value);
            const notas = document.getElementById("txtNotas").value;

            if (!idPlatillo || cantidad <= 0) {
                alert("Seleccione un platillo válido.");
                return;
            }

            const nombrePlatillo = textPlatillo.split(" (")[0];
            const subtotal = cantidad * precioUnitario;
            const tbody = document.querySelector("#tablaDetalles tbody");

            const fila = document.createElement("tr");
            fila.setAttribute("id", `fila-${itemIndex}`);
            fila.innerHTML = `
                        <td>
                            <input type="hidden" name="DetallePedidos[${itemIndex}].IdPlatillo" value="${idPlatillo}" />
                            ${nombrePlatillo}
                        </td>
                        <td class="text-center">
                            <input type="hidden" name="DetallePedidos[${itemIndex}].Cantidad" value="${cantidad}" />
                            <span class="badge bg-secondary px-3 py-2">${cantidad}</span>
                        </td>
                        <td class="text-end">S/ ${precioUnitario.toFixed(2)}</td>
                        <td class="text-end text-info fw-bold subtotal-item" data-subtotal="${subtotal}">S/ ${subtotal.toFixed(2)}</td>
                        <td>
                            <input type="hidden" name="DetallePedidos[${itemIndex}].NotasChef" value="${notas}" />
                            <span class="text-muted small">${notas || '-'}</span>
                        </td>
                        <td class="text-center">
                            <button type="button" class="btn btn-outline-danger btn-sm" onclick="quitarFila(${itemIndex})"><i class="fas fa-trash"></i></button>
                        </td>
                    `;

            tbody.appendChild(fila);
            itemIndex++;

            select.value = "";
            document.getElementById("txtCantidad").value = 1;
            document.getElementById("txtNotas").value = "";
            calcularTotalGeneral();
        });

        function quitarFila(index) {
            document.getElementById(`fila-${index}`).remove();
            calcularTotalGeneral();
            reestructurarIndices();
        }

        function calcularTotalGeneral() {
            let total = 0;
            document.querySelectorAll(".subtotal-item").forEach(el => {
                total += parseFloat(el.getAttribute("data-subtotal"));
            });
            document.getElementById("lblTotal").innerText = "S/ " + total.toFixed(2);
        }

        function reestructurarIndices() {
            itemIndex = 0;
            document.querySelectorAll("#tablaDetalles tbody tr").forEach(fila => {
                fila.setAttribute("id", `fila-${itemIndex}`);
                fila.querySelector('input[name$=".IdPlatillo"]').setAttribute("name", `DetallePedidos[itemIndex].IdPlatillo`);
                fila.querySelector('input[name$=".Cantidad"]').setAttribute("name", `DetallePedidos[itemIndex].Cantidad`);
                fila.querySelector('input[name$=".NotasChef"]').setAttribute("name", `DetallePedidos[itemIndex].NotasChef`);
                fila.querySelector('button').setAttribute("onclick", `quitarFila(${itemIndex})`);
                itemIndex++;
            });
        }
    </script>
}