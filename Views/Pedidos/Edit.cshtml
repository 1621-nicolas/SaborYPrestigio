@model SaborPrestigioMVC.Models.Pedido

@{
    ViewData["Title"] = "Editar Pedido";
}
<link rel="stylesheet" href="~/css/dashboard.css" />

<div class="main-dashboard">
    <div class="dashboard-card">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="titulo-ventas">🛒 Gestionar Pedido #@Model.IdPedido</h2>
                <span style="color:#ccc;">
                    Actualiza el estado, asigna mesa o empleado
                </span>
            </div>
            <a asp-action="Index" class="btn btn-secondary">← Volver</a>
        </div>

        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <input type="hidden" asp-for="IdPedido" />
            <input type="hidden" asp-for="IdCliente" />
            <input type="hidden" asp-for="TipoPedido" />
            <input type="hidden" asp-for="FechaPedido" />

            @{
                int index = 0;
            }
            @if (Model.DetallePedidos != null)
            {
                foreach (var detalle in Model.DetallePedidos)
                {
                    <input type="hidden" name="DetallePedidos[@index].IdPlatillo" value="@detalle.IdPlatillo" />
                    <input type="hidden" name="DetallePedidos[@index].Cantidad" value="@detalle.Cantidad" />
                    <input type="hidden" name="DetallePedidos[@index].PrecioUnitario" value="@detalle.PrecioUnitario" />
                    index++;
                }
            }

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label class="form-label text-warning fw-bold">Mozo Asignado</label>
                    <select asp-for="IdEmpleado" asp-items="ViewBag.Empleados" class="form-control">
                        <option value="">-- Sin asignar --</option>
                    </select>
                    <span asp-validation-for="IdEmpleado" class="text-danger"></span>
                </div>

                <div class="col-md-4 mb-3">
                    <label class="form-label text-warning fw-bold">Mesa</label>
                    <select asp-for="IdMesa" asp-items="ViewBag.Mesas" class="form-control">
                        <option value="">-- Sin mesa -- (Para llevar)</option>
                    </select>
                    <span asp-validation-for="IdMesa" class="text-danger"></span>
                </div>

                <div class="col-md-4 mb-4">
                    <label class="form-label text-warning fw-bold">Estado en Cocina</label>
                    <select asp-for="EstadoPedido" class="form-control bg-dark text-white border-warning">
                        <option value="En Espera">En Espera</option>
                        <option value="En Cocina">En Cocina</option>
                        <option value="Listo">Listo</option>
                        <option value="Entregado">Entregado</option>
                        <option value="Cancelado">Cancelado</option>
                    </select>
                    <span asp-validation-for="EstadoPedido" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-4 p-3 rounded" style="background-color: #1a1a1a; border: 1px solid #333;">
                <h5 class="text-warning mb-3"><i class="bi bi-receipt"></i> Resumen del Consumo</h5>
                <table class="table table-dark table-sm table-borderless mb-0">
                    <thead>
                        <tr style="border-bottom: 1px solid #444;">
                            <th>Cant.</th>
                            <th>Platillo</th>
                            <th class="text-end">P. Unitario</th>
                            <th class="text-end">Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.DetallePedidos != null)
                        {
                            foreach (var item in Model.DetallePedidos)
                            {
                                <tr>
                                    <td>@item.Cantidad</td>
                                    <td>@(item.Platillo?.NombrePlatillo ?? "Desconocido")</td>
                                    <td class="text-end">S/ @item.PrecioUnitario.ToString("0.00")</td>
                                    <td class="text-end">S/ @((item.Cantidad * item.PrecioUnitario).ToString("0.00"))</td>
                                </tr>
                            }
                        }
                    </tbody>
                    <tfoot>
                        <tr style="border-top: 1px solid #444;">
                            <td colspan="3" class="text-end fw-bold text-warning pt-2">TOTAL:</td>
                            <td class="text-end fw-bold text-warning pt-2">S/ @Model.Total.ToString("0.00")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <hr class="border-secondary" />

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-warning fw-bold">
                    💾 Actualizar Pedido
                </button>
                <a asp-action="Index" class="btn btn-outline-light">
                    Cancelar
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}