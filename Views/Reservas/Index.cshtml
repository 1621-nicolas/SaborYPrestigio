@model IEnumerable<SaborPrestigioMVC.Models.Reserva>

@{
    ViewData["Title"] = "Reservas";
}

<link rel="stylesheet" href="~/css/dashboard.css" />

<div class="main-dashboard">
    <div class="dashboard-card">

        <div class="d-flex justify-content-between align-items-center mb-4 text-white">
            <div>
                <h2 class="mb-0"><i class="fas fa-calendar-alt me-2"></i>Gestión de Reservas</h2>
                <span class="text-muted small">Monitoreo y asignación de mesas en salón</span>
            </div>

            <div class="d-flex gap-2">
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-light d-flex align-items-center">
                    <i class="fas fa-arrow-left me-2"></i> Volver al Inicio
                </a>
                <a asp-action="Create" class="btn btn-warning fw-bold text-dark d-flex align-items-center">
                    <i class="fas fa-plus me-1"></i> Nueva Reserva
                </a>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle table-dark table-striped custom-table">
                <thead>
                    <tr>
                        <th>Cliente</th>
                        <th>Mesa</th>
                        <th>Fecha</th>
                        <th>Hora</th>
                        <th>Personas</th>
                        <th>Origen</th>
                        <th>Estado</th>
                        <th>Creación</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="table-row-glow">
                            <td>
                                @(item.Cliente != null ? $"{item.Cliente.Nombre} {item.Cliente.Apellido}" : "-")
                            </td>
                            <td>
                                @(item.Mesa != null ? $"Mesa {item.Mesa.NumeroMesa}" : "-")
                            </td>
                            <td>@item.FechaReserva.ToString("dd/MM/yyyy")</td>
                            <td>@item.HoraReserva</td>
                            <td>@item.CantidadPersonas</td>
                            <td>@item.Origen</td>
                            <td>
                                @if (item.EstadoReserva == "Confirmada")
                                {
                                    <span class="badge bg-success">Confirmada</span>
                                }
                                else if (item.EstadoReserva == "Pendiente")
                                {
                                    <span class="badge bg-warning text-dark">Pendiente</span>
                                }
                                else if (item.EstadoReserva == "Cancelada")
                                {
                                    <span class="badge bg-danger">Cancelada</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@item.EstadoReserva</span>
                                }
                            </td>
                            <td>@item.FechaCreacion.ToString("dd/MM/yyyy")</td>
                            <td class="text-center">
                                <div class="btn-group" role="group">
                                    <a asp-action="Edit" asp-route-id="@item.IdReserva" class="btn btn-sm btn-outline-warning">Editar</a>
                                    <a asp-action="Details" asp-route-id="@item.IdReserva" class="btn btn-sm btn-outline-info">Ver</a>
                                    <a asp-action="Delete" asp-route-id="@item.IdReserva" class="btn btn-sm btn-outline-danger">Eliminar</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>