@model IEnumerable<SaborPrestigioMVC.Models.Reserva>

@{
    ViewData["Title"] = "Reservas";
}

<link rel="stylesheet" href="~/css/dashboard.css" />

<div class="dashboard-card">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <h4 class="titulo-estados">📅 Gestión de Reservas</h4>

        <a asp-action="Create" class="btn btn-warning fw-bold">
            + Nueva Reserva
        </a>

    </div>

    <div class="table-responsive">

        <table class="table table-hover align-middle table-dark table-striped">

            <thead>
                <tr>
                    <th>Cliente</th>
                    <th>Mesa</th>
                    <th>Fecha</th>
                    <th>Hora</th>
                    <th>Personas</th>
                    <th>Origen</th>
                    <th>Estado</th>
                    <th>Creación</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>

                        <td>
                            @(item.Cliente != null ? item.Cliente.Nombre + " " + item.Cliente.Apellido : "-")
                        </td>

                        <td>
                            @(item.Mesa != null ? "Mesa " + item.Mesa.NumeroMesa : "-")
                        </td>

                        <td>@item.FechaReserva.ToString("dd/MM/yyyy")</td>

                        <td>@item.HoraReserva</td>

                        <td>@item.CantidadPersonas</td>

                        <td>@item.Origen</td>

                        <td>
                            @if (item.EstadoReserva == "Confirmada")
                            {
                                <span class="badge bg-success">Confirmada</span>
                            }
                            else if (item.EstadoReserva == "Pendiente")
                            {
                                <span class="badge bg-warning text-dark">Pendiente</span>
                            }
                            else if (item.EstadoReserva == "Cancelada")
                            {
                                <span class="badge bg-danger">Cancelada</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@item.EstadoReserva</span>
                            }
                        </td>

                        <td>@item.FechaCreacion.ToString("dd/MM/yyyy")</td>

                        <td>
                            <a asp-action="Edit" asp-route-idreserva="@item.IdReserva" class="btn btn-sm btn-primary">Editar</a>
                            <a asp-action="Details" asp-route-idreserva="@item.IdReserva" class="btn btn-sm btn-info text-white">Ver</a>
                            <a asp-action="Delete" asp-route-idreserva="@item.IdReserva" class="btn btn-sm btn-danger">Eliminar</a>
                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>