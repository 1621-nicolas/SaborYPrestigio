@model SaborPrestigioMVC.Models.Reserva

@{
    ViewData["Title"] = "Detalle de Reserva";
}
<link rel="stylesheet" href="~/css/dashboard.css" />

<div class="main-dashboard">
    <div class="dashboard-card" style="max-width: 750px; margin: 0 auto;">

        <div class="text-center mb-4 text-white">
            <h2 class="text-warning fw-bold">📋 Detalle de la Reserva #@Model.IdReserva</h2>
            <p class="text-muted">Información operativa registrada para control de aforo</p>
        </div>

        <div class="row bg-dark p-4 rounded border border-secondary text-white">
            <div class="col-md-6 mb-3">
                <small class="text-warning fw-bold d-block">Cliente Solicitante</small>
                <span class="fs-5">@(Model.Cliente != null ? $"{Model.Cliente.Nombre} {Model.Cliente.Apellido}" : "Cliente General")</span>
            </div>

            <div class="col-md-6 mb-3">
                <small class="text-warning fw-bold d-block">Mesa Asignada</small>
                <span class="fs-5">@(Model.Mesa != null ? $"Mesa {Model.Mesa.NumeroMesa} ({Model.Mesa.Zona})" : "Sin mesa asignada")</span>
            </div>

            <div class="col-md-4 mb-3">
                <small class="text-warning fw-bold d-block">Fecha del Servicio</small>
                <span class="fs-5">🗓️ @Model.FechaReserva.ToString("dd/MM/yyyy")</span>
            </div>

            <div class="col-md-4 mb-3">
                <small class="text-warning fw-bold d-block">Hora Programada</small>
                <span class="fs-5">⏰ @Model.HoraReserva</span>
            </div>

            <div class="col-md-4 mb-3">
                <small class="text-warning fw-bold d-block">Cantidad de Asistentes</small>
                <span class="fs-5">👥 @Model.CantidadPersonas personas</span>
            </div>

            <div class="col-md-6 mb-1">
                <small class="text-warning fw-bold d-block">Canal de Origen</small>
                <span class="fs-5">@Model.Origen</span>
            </div>

            <div class="col-md-6 mb-1">
                <small class="text-warning fw-bold d-block">Estado de Gestión</small>
                <span class="fs-5">@Model.EstadoReserva</span>
            </div>
        </div>

        <div class="d-flex justify-content-center gap-3 mt-4">
            <a asp-action="Edit" asp-route-id="@Model.IdReserva" class="btn btn-warning fw-bold px-4">✏️ Gestionar / Editar</a>
            <a asp-action="Index" class="btn btn-outline-light px-4">Volver a la Lista</a>
        </div>
    </div>
</div>