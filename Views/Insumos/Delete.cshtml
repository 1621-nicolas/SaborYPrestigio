@model SaborPrestigioMVC.Models.Insumo

@{
    ViewData["Title"] = "Eliminar Insumo";
}

<div class="container mt-5 text-white" style="max-width: 550px;">
    <div class="card border-danger bg-dark shadow">
        <div class="card-header bg-black border-danger py-3 text-center">
            <h4 class="text-danger mb-0"><i class="fas fa-trash-alt"></i> ¿Retirar Insumo del Inventario?</h4>
        </div>
        <div class="card-body p-4 text-center">
            <p class="text-muted">Esta acción retirará la materia prima del sistema. No se podrá revertir si destruye registros logísticos.</p>

            <div class="p-3 bg-black rounded border border-secondary text-start my-4">
                <div class="mb-2"><strong>Materia Prima / Insumo:</strong> <span class="text-white ms-2">@Model.NombreInsumo</span></div>
                <div class="mb-2"><strong>Medida Física:</strong> <span class="text-muted ms-2">@Model.UnidadMedida</span></div>
                <div><strong>Existencias a Descartar:</strong> <span class="text-danger ms-2 fw-bold">@Model.StockActual.ToString("0.000") @Model.UnidadMedida</span></div>
            </div>

            <form asp-action="Delete" asp-route-id="@Model.IdInsumo" method="post" class="mt-4">
                <input type="hidden" asp-for="IdInsumo" />
                <button type="submit" class="btn btn-danger px-4 fw-bold shadow">Confirmar Baja</button>
                <a asp-action="Index" class="btn btn-secondary px-4 ms-2">Cancelar</a>
            </form>
        </div>
    </div>
</div>