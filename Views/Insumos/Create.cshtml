@model SaborPrestigioMVC.Models.Insumo

@{
    ViewData["Title"] = "Registrar Insumo";
}

<div class="container mt-4 text-white">
    <h2>Registrar Nuevo Insumo</h2>
    <h4 class="text-muted small">Control de Inventario y Alertas de Stock Crítico</h4>
    <hr class="border-secondary" />

    <div class="row">
        <!-- Tarjeta contenedora con la estética oscura y dorada del restaurante -->
        <div class="col-xl-6 col-md-8 mb-4">
            <div class="card bg-dark border-secondary shadow-sm">
                <div class="card-header border-secondary bg-black text-warning fw-bold">
                    <i class="fas fa-box me-1"></i> Especificaciones del Insumo / Materia Prima
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <!-- Nombre del Insumo -->
                        <div class="form-group mb-3">
                            <label asp-for="NombreInsumo" class="form-label fw-bold text-warning">Nombre del Insumo</label>
                            <input asp-for="NombreInsumo" class="form-control bg-black text-white border-secondary" placeholder="Ej. Carne de Res Lomo Fino, Papas Amarillas" />
                            <span asp-validation-for="NombreInsumo" class="text-danger small"></span>
                        </div>

                        <!-- Unidad de Medida (Combobox Estricto según tu BD) -->
                        <div class="form-group mb-3">
                            <label asp-for="UnidadMedida" class="form-label fw-bold text-warning">Unidad de Medida</label>
                            <select asp-for="UnidadMedida" class="form-select bg-black text-white border-secondary">
                                <option value="" class="text-warning">-- Seleccione Unidad --</option>
                                <option value="Kg" class="text-warning">Kilogramos (Kg)</option>
                                <option value="Litros" class="text-warning">Litros</option>
                                <option value="Unidades" class="text-warning">Unidades</option>
                                <option value="Gramos" class="text-warning">Gramos</option>
                            </select>
                            <span asp-validation-for="UnidadMedida" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <!-- Stock Actual -->
                            <div class="col-md-6 form-group mb-3">
                                <label asp-for="StockActual" class="form-label fw-bold text-warning">Stock Inicial Actual</label>
                                <input asp-for="StockActual" type="number" step="0.001" class="form-control bg-black text-white border-secondary" placeholder="0.000" value="0.000" />
                                <span asp-validation-for="StockActual" class="text-danger small"></span>
                            </div>

                            <!-- Stock Mínimo -->
                            <div class="col-md-6 form-group mb-3">
                                <label asp-for="StockMinimo" class="form-label fw-bold text-warning">Stock Mínimo (Alerta)</label>
                                <input asp-for="StockMinimo" type="number" step="0.001" class="form-control bg-black text-white border-secondary" placeholder="Ej. 5.000" />
                                <span asp-validation-for="StockMinimo" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Precio Costo Promedio -->
                        <div class="form-group mb-4">
                            <label asp-for="PrecioCostoPromedio" class="form-label fw-bold text-warning">Precio Costo Promedio</label>
                            <div class="input-group">
                                <span class="input-group-text bg-secondary border-secondary text-white">S/</span>
                                <input asp-for="PrecioCostoPromedio" type="number" step="0.01" class="form-control bg-black text-white border-secondary" placeholder="0.00" value="0.00" />
                            </div>
                            <span asp-validation-for="PrecioCostoPromedio" class="text-danger small"></span>
                        </div>

                        <!-- Botones integrados -->
                        <div class="form-group pt-2 border-top border-secondary">
                            <button type="submit" class="btn btn-primary px-4 shadow">Registrar Insumo</button>
                            <a asp-action="Index" class="btn btn-secondary px-4 ms-2">Volver</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Estilo preventivo para que las opciones del desplegable mantengan la armonía dorada en cualquier navegador */
    select.form-select option {
        background-color: #000000 !important;
        color: #ffc107 !important;
    }
</style>

@section Scripts {
    @{


        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}