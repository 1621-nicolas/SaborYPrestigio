@model IEnumerable<SaborPrestigioMVC.Models.Insumo>

@{
    ViewData["Title"] = "Insumos";
}
<link rel="stylesheet" href="~/css/dashboard.css" />

<div class="dashboard-card">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="titulo-estados text-warning fw-bold">📦 Gestión de Insumos</h4>
        <a asp-action="Create" class="btn btn-warning fw-bold shadow-sm">
            + Nuevo Insumo
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-hover table-dark table-striped align-middle border-secondary">
            <thead class="table-black text-muted small text-uppercase">
                <tr>
                    <th>Insumo</th>
                    <th class="text-center">Unidad</th>
                    <th class="text-end">Stock Actual</th>
                    <th class="text-end">Stock Mínimo</th>
                    <th class="text-end">Precio Promedio</th>
                    <th class="text-center">Estado</th>
                    <th class="text-center" style="width: 220px;">Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong class="text-white">@item.NombreInsumo</strong></td>

                        <td class="text-center">
                            <span class="badge bg-secondary">@item.UnidadMedida</span>
                        </td>

                        <!-- Formateo a 3 decimales para Kg/Litros según tu diseño de BD -->
                        <td class="text-end text-info fw-bold">
                            @item.StockActual.ToString("0.000")
                        </td>

                        <td class="text-end text-muted">
                            @item.StockMinimo.ToString("0.000")
                        </td>

                        <td class="text-end text-warning">
                            S/ @item.PrecioCostoPromedio.ToString("0.00")
                        </td>

                        <td class="text-center">
                            @if (item.StockActual <= item.StockMinimo)
                            {
                                <span class="badge bg-danger p-2 w-100 text-uppercase">Bajo stock</span>
                            }
                            else if (item.StockActual <= (item.StockMinimo * 1.5m))
                            {
                                <span class="badge bg-warning text-dark p-2 w-100 text-uppercase">Stock medio</span>
                            }
                            else
                            {
                                <span class="badge bg-success p-2 w-100 text-uppercase">OK</span>
                            }
                        </td>

                        <td class="text-center">
                            <a asp-action="Edit"
                               asp-route-id="@item.IdInsumo"
                               class="btn btn-sm btn-primary px-2">
                                Editar
                            </a>
                            <a asp-action="Details"
                               asp-route-id="@item.IdInsumo"
                               class="btn btn-sm btn-info text-white px-2">
                                Ver
                            </a>
                          
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>