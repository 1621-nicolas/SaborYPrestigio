@model SaborPrestigioMVC.Models.Cliente

@{
    ViewData["Title"] = "Detalles del Cliente";
}
<link rel="stylesheet" href="~/css/dashboard.css" />

<div class="main-dashboard">
    <div class="dashboard-card" style="max-width: 800px; margin: 0 auto;">

        <div class="text-center mb-4">
            <h2 class="text-warning fw-bold">👤 Perfil del Cliente</h2>
            <p class="text-muted">Información detallada registrada en el sistema</p>
        </div>

        <div class="row bg-dark p-4 rounded border border-secondary">
            <div class="col-md-6 mb-3">
                <small class="text-warning fw-bold d-block">DNI / RUC</small>
                <span class="text-white fs-5">@Model.DniRuc</span>
            </div>
            <div class="col-md-6 mb-3">
                <small class="text-warning fw-bold d-block">Fecha de Registro</small>
                <span class="text-white fs-5">@Model.FechaRegistro.ToString("dd/MM/yyyy")</span>
            </div>

            <div class="col-md-6 mb-3">
                <small class="text-warning fw-bold d-block">Nombres</small>
                <span class="text-white fs-5">@Model.Nombre</span>
            </div>
            <div class="col-md-6 mb-3">
                <small class="text-warning fw-bold d-block">Apellidos</small>
                <span class="text-white fs-5">@(string.IsNullOrEmpty(Model.Apellido) ? "-" : Model.Apellido)</span>
            </div>

            <div class="col-md-6 mb-3">
                <small class="text-warning fw-bold d-block">Teléfono</small>
                <span class="text-white fs-5">📞 @Model.Telefono</span>
            </div>
            <div class="col-md-6 mb-3">
                <small class="text-warning fw-bold d-block">Correo Electrónico</small>
                <span class="text-white fs-5">✉️ @Model.Email</span>
            </div>
        </div>

        <div class="d-flex justify-content-center gap-3 mt-4">
            <a asp-action="Edit" asp-route-id="@Model?.IdCliente" class="btn btn-warning fw-bold px-4">✏️ Editar</a>
            <a asp-action="Index" class="btn btn-outline-light px-4">Volver a la lista</a>
        </div>
    </div>
</div>