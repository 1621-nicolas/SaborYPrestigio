@model SaborPrestigioMVC.Models.Cliente

@{
    ViewData["Title"] = "Eliminar Cliente";
}
<link rel="stylesheet" href="~/css/dashboard.css" />

<div class="main-dashboard">
    <div class="dashboard-card" style="max-width: 600px; margin: 0 auto; border-left: 5px solid #dc3545;">

        <div class="text-center mb-4">
            <h2 class="text-danger fw-bold"><i class="bi bi-exclamation-triangle-fill"></i> Eliminar Cliente</h2>
            <p class="text-white fs-5 mt-2">¿Estás completamente seguro de que deseas eliminar a este cliente?</p>
            <p class="text-muted small">Esta acción no se puede deshacer.</p>
        </div>

        <div class="bg-dark p-3 rounded mb-4 text-center border border-secondary">
            <h4 class="text-warning mb-1">@Model.Nombre @Model.Apellido</h4>
            <div class="text-light">
                <strong>DNI/RUC:</strong> @Model.DniRuc <br />
                <strong>Email:</strong> @Model.Email
            </div>
        </div>

        <form asp-action="Delete" class="text-center">
            <input type="hidden" asp-for="IdCliente" />
            <button type="submit" class="btn btn-danger fw-bold px-4 me-2">🗑️ Sí, Eliminar</button>
            <a asp-action="Index" class="btn btn-secondary px-4">Cancelar</a>
        </form>
    </div>
</div>