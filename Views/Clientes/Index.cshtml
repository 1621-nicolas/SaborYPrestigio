@model IEnumerable<SaborPrestigioMVC.Models.Cliente>

@{
    ViewData["Title"] = "Clientes";
    int totalPaginas = ViewBag.TotalPaginas ?? 1;
    int paginaActual = ViewBag.PaginaActual ?? 1;
}

<div class="main-dashboard">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="titulo-ventas">Clientes</h2>
            <span style="color:#ccc;">Gestión de clientes registrados</span>
        </div>

        <a asp-action="Create" class="btn btn-gold">
            + Registrar Cliente
        </a>
    </div>

    <form asp-action="Index" method="get" class="mb-3 d-flex gap-2">
        <input type="text"
               name="buscar"
               value="@ViewBag.Buscar"
               class="form-control"
               placeholder="Buscar por nombre, apellido, DNI/RUC o email..." />

        <button type="submit" class="btn btn-primary">Buscar</button>
        <a asp-action="Index" class="btn btn-secondary">Limpiar</a>
    </form>

    <div class="dashboard-card">
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle custom-table">
                <thead>
                    <tr>
                        <th>DNI/RUC</th>
                        <th>Nombre</th>
                        <th>Apellido</th>
                        <th>Teléfono</th>
                        <th>Email</th>
                        <th>Fecha Registro</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted">
                                No se encontraron clientes.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr class="table-row-glow">
                                <td>
                                    <span class="badge bg-secondary">@item.DniRuc</span>
                                </td>

                                <td class="fw-bold text-warning">@item.Nombre</td>
                                <td>@item.Apellido</td>
                                <td>📞 @item.Telefono</td>
                                <td>✉️ @item.Email</td>
                                <td>🗓 @item.FechaRegistro.ToString("dd/MM/yyyy")</td>

                                <td class="text-center">
                                    <a asp-action="Edit"
                                       asp-route-idcliente="@item.IdCliente"
                                       class="btn btn-sm btn-outline-warning">
                                        Editar
                                    </a>

                                    <a asp-action="Details"
                                       asp-route-idcliente="@item.IdCliente"
                                       class="btn btn-sm btn-outline-info">
                                        Ver
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-idcliente="@item.IdCliente"
                                       class="btn btn-sm btn-outline-danger">
                                        Eliminar
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (totalPaginas > 1)
        {
            <nav class="mt-3">
                <ul class="pagination justify-content-center">

                    <li class="page-item @(paginaActual == 1 ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-pagina="@(paginaActual - 1)"
                           asp-route-buscar="@ViewBag.Buscar">
                            Anterior
                        </a>
                    </li>

                    @for (int i = 1; i <= totalPaginas; i++)
                    {
                        <li class="page-item @(i == paginaActual ? "active" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-pagina="@i"
                               asp-route-buscar="@ViewBag.Buscar">
                                @i
                            </a>
                        </li>
                    }

                    <li class="page-item @(paginaActual == totalPaginas ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-pagina="@(paginaActual + 1)"
                           asp-route-buscar="@ViewBag.Buscar">
                            Siguiente
                        </a>
                    </li>

                </ul>
            </nav>
        }
    </div>
</div>