@model IEnumerable<SaborPrestigioMVC.Models.Cliente>

@{
    ViewData["Title"] = "Clientes";
    int totalPaginas = ViewBag.TotalPaginas ?? 1;
    int paginaActual = ViewBag.PaginaActual ?? 1;
}
<div class="main-dashboard">

    <div class="d-flex justify-content-between align-items-center mb-4 text-white">
        <div>
            <h2 class="mb-1">Clientes</h2>
            <span class="text-muted small">Gestión de clientes registrados</span>
        </div>

        <div class="d-flex gap-2">
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-light d-flex align-items-center">
                <i class="fas fa-arrow-left me-2"></i> Volver al Inicio
            </a>
            <a asp-action="Create" class="btn btn-warning fw-bold text-dark d-flex align-items-center">
                <i class="fas fa-plus me-1"></i> Registrar Cliente
            </a>
        </div>
    </div>

    <form asp-action="Index" method="get" class="mb-3 d-flex gap-2">
        <input type="text" name="buscar" value="@ViewBag.Buscar" class="form-control" placeholder="Buscar por nombre, apellido, DNI/RUC o email..." />
        <button type="submit" class="btn btn-primary">Buscar</button>
        <a asp-action="Index" class="btn btn-secondary">Limpiar</a>
    </form>

    <div class="dashboard-card">
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle custom-table">
                <thead>
                    <tr>
                        <th>DNI/RUC</th>
                        <th>Nombre</th>
                        <th>Apellido</th>
                        <th>Teléfono</th>
                        <th>Email</th>
                        <th>Fecha Registro</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted">No se encontraron clientes.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr class="table-row-glow">
                                <td><span class="badge bg-secondary">@item.DniRuc</span></td>
                                <td class="fw-bold text-warning">@item.Nombre</td>
                                <td>@item.Apellido</td>
                                <td>📞 @item.Telefono</td>
                                <td>✉️ @item.Email</td>
                                <td>🗓 @item.FechaRegistro.ToString("dd/MM/yyyy")</td>
                                <td class="text-center">
                                    <!-- 🔥 CORREGIDO: asp-route-id -->
                                    <a asp-action="Edit" asp-route-id="@item.IdCliente" class="btn btn-sm btn-outline-warning">Editar</a>
                                    <a asp-action="Details" asp-route-id="@item.IdCliente" class="btn btn-sm btn-outline-info">Ver</a>
                                    <a asp-action="Delete" asp-route-id="@item.IdCliente" class="btn btn-sm btn-outline-danger">Eliminar</a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Paginación mantenida igual -->
    </div>
</div>