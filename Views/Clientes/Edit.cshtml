@model SaborPrestigioMVC.Models.Cliente

@{
    ViewData["Title"] = "Editar Cliente";
}
<link rel="stylesheet" href="~/css/dashboard.css" />

<div class="main-dashboard">
    <div class="dashboard-card">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="titulo-ventas text-warning">✏️ Editar Cliente</h2>
                <span style="color:#ccc;">Modifique los datos del cliente seleccionado</span>
            </div>
        </div>

        <form asp-action="Edit">
            <!-- 🔥 CAMPOS OCULTOS VITALES -->
            <input type="hidden" asp-for="IdCliente" />
            <input type="hidden" asp-for="FechaRegistro" />
            <input type="hidden" asp-for="Clave" /> 

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="DniRuc" class="form-label text-white">DNI / RUC</label>
                    <input asp-for="DniRuc" maxlength="11" class="form-control" />
                    <span asp-validation-for="DniRuc" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Telefono" class="form-label text-white">Teléfono</label>
                    <input asp-for="Telefono" maxlength="9" class="form-control" />
                    <span asp-validation-for="Telefono" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Nombre" class="form-label text-white">Nombre</label>
                    <input asp-for="Nombre" class="form-control" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Apellido" class="form-label text-white">Apellido</label>
                    <input asp-for="Apellido" class="form-control" />
                    <span asp-validation-for="Apellido" class="text-danger"></span>
                </div>

                <div class="col-md-12 mb-4">
                    <label asp-for="Email" class="form-label text-white">Correo Electrónico</label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
            </div>

            <hr class="border-secondary" />

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-warning fw-bold">💾 Guardar Cambios</button>
                <a asp-action="Index" class="btn btn-outline-light">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.getElementById("DniRuc").addEventListener("input", function () {
            this.value = this.value.replace(/\D/g,'');
        });
        document.getElementById("Telefono").addEventListener("input", function () {
            this.value = this.value.replace(/\D/g,'');
        });
    </script>
}