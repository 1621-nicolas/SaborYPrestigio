@model SaborPrestigioMVC.Models.ComprobantePago

@{
    ViewData["Title"] = "Anular Comprobante";
}

<div class="container mt-5 text-white" style="max-width: 580px;">
    <div class="card border-danger bg-dark shadow">
        <div class="card-header bg-black border-danger py-3 text-center">
            <h4 class="text-danger mb-0"><i class="fas fa-exclamation-triangle me-2"></i>¿Desea Anular este Comprobante?</h4>
        </div>
        <div class="card-body p-4">
            <p class="text-muted text-center small">Esta acción dará de baja el documento fiscal del sistema contable de caja de forma permanente.</p>

            <div class="p-3 bg-black rounded border border-secondary small mb-4">
                <div class="mb-2"><strong>Tipo Documento:</strong> <span class="badge bg-secondary ms-2 text-uppercase">@Model.TipoComprobante</span></div>
                <div class="mb-2"><strong>Serie-Número:</strong> <span class="text-danger ms-2 font-mono fw-bold">@Model.Serie-@Model.Correlativo.ToString("D6")</span></div>
                <div class="mb-2"><strong>Titular:</strong> <span class="text-white ms-2">@Model.ClienteNombreORazonSocial</span></div>
                <div><strong>Monto Total de Caja:</strong> <span class="text-warning ms-2 fw-bold">S/ @Model.MontoTotal.ToString("0.00")</span></div>
            </div>

            <form asp-action="Delete" asp-route-id="@Model.IdComprobante" method="post" class="text-center mt-4">
                <input type="hidden" asp-for="IdComprobante" />
                <button type="submit" class="btn btn-danger px-4 fw-bold shadow">Confirmar Anulación</button>
                <a asp-action="Index" class="btn btn-secondary px-4 ms-2">Cancelar</a>
            </form>
        </div>
    </div>
</div>

<style>
    .font-mono {
        font-family: SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    }
</style>